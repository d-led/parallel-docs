{
  "name": "@parallel-docs/cli",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "ParallelDocs command-line interface. Run with npx parallel-docs; npx parallel-docs --help prints Usage: parallel-docs [options] [command].",
  "license": "MPL-2.0",
  "type": "module",
  "bin": {
    "parallel-docs": "./dist/cli.js"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "build:bundle": "npm run build && node ./esbuild.cli.mjs",
    "clean": "rm -rf dist",
    "parallel-docs": "node ./dist/cli.js"
  },
  "dependencies": {
    "@parallel-docs/code-parallel-docs-static": "1.0.0",
    "@parallel-docs/core": "1.0.0",
    "@parallel-docs/mcp-server": "1.0.0",
    "@parallel-docs/render": "1.0.0",
    "chokidar": "^5.0.0",
    "commander": "^15.0.0",
    "ignore": "^7.0.5",
    "serve-handler": "^6.1.7"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "@types/serve-handler": "^6.1.4",
    "esbuild": "^0.28.1",
    "postject": "^1.0.0-alpha.6"
  }
}
