{
  "name": "parallel-docs",
  "displayName": "Parallel Docs",
  "description": "Out-of-file documentation side tracks, authored side-by-side with your code",
  "version": "1.0.0",
  "publisher": "d-led",
  "license": "MPL-2.0",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/d-led/parallel-docs.git",
    "directory": "packages/vscode"
  },
  "homepage": "https://github.com/d-led/parallel-docs#readme",
  "bugs": {
    "url": "https://github.com/d-led/parallel-docs/issues"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:parallel-docs.init",
    "onCommand:parallel-docs.openSideBySide",
    "onCommand:parallel-docs.openParallelDocsAngle",
    "onCommand:parallel-docs.addAngleDefinition",
    "onCommand:parallel-docs.startBlockFromSelection",
    "onCommand:parallel-docs.openParallelDocsPreview",
    "onCommand:parallel-docs.openRenderedPreview",
    "onCommand:parallel-docs.openRenderedPreviewChooseAngle",
    "onCommand:parallel-docs.validateWorkspace",
    "onCommand:parallel-docs.openCorrespondingSource",
    "onCommand:parallel-docs.removeBlock",
    "onCommand:parallel-docs.cleanRegions",
    "onCommand:parallel-docs.repairFile"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "ParallelDocs",
      "properties": {
        "parallel-docs.scrollSync.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "When enabled, scrolling the source editor updates the paired parallel-docs editor (and vice versa), using block anchors when available. Reload or reopen the pair after changing this setting."
        }
      }
    },
    "commands": [
      {
        "command": "parallel-docs.init",
        "title": "Initialize workspace",
        "category": "ParallelDocs",
        "enablement": "!parallel-docs.workspaceInitialized"
      },
      {
        "command": "parallel-docs.openSideBySide",
        "title": "Open paired markdown beside editor",
        "category": "ParallelDocs",
        "enablement": "parallel-docs.workspaceInitialized && !parallel-docs.activeEditorUnderCompanionSourceTree"
      },
      {
        "command": "parallel-docs.openParallelDocsAngle",
        "title": "Open paired markdown (choose angle)",
        "category": "ParallelDocs",
        "enablement": "parallel-docs.workspaceInitialized && !parallel-docs.activeEditorUnderCompanionSourceTree"
      },
      {
        "command": "parallel-docs.addAngleDefinition",
        "title": "Add angle to project…",
        "category": "ParallelDocs",
        "enablement": "parallel-docs.workspaceInitialized"
      },
      {
        "command": "parallel-docs.startBlockFromSelection",
        "title": "Add side-track block from selection",
        "category": "ParallelDocs",
        "enablement": "parallel-docs.workspaceInitialized && !parallel-docs.activeEditorUnderCompanionSourceTree && !editorReadonly"
      },
      {
        "command": "parallel-docs.openParallelDocsPreview",
        "title": "Open Markdown preview for paired file",
        "category": "ParallelDocs",
        "enablement": "parallel-docs.workspaceInitialized && (!parallel-docs.activeEditorUnderCompanionSourceTree || editorLangId == markdown)"
      },
      {
        "command": "parallel-docs.openRenderedPreview",
        "title": "Open rendered ParallelDocs preview (default angle)",
        "category": "ParallelDocs",
        "enablement": "parallel-docs.workspaceInitialized && !parallel-docs.activeEditorUnderCompanionSourceTree"
      },
      {
        "command": "parallel-docs.openRenderedPreviewChooseAngle",
        "title": "Open rendered ParallelDocs preview (choose angle)…",
        "category": "ParallelDocs",
        "enablement": "parallel-docs.workspaceInitialized && !parallel-docs.activeEditorUnderCompanionSourceTree"
      },
      {
        "command": "parallel-docs.validateWorkspace",
        "title": "Validate workspace",
        "category": "ParallelDocs"
      },
      {
        "command": "parallel-docs.openCorrespondingSource",
        "title": "Open corresponding source file",
        "category": "ParallelDocs",
        "enablement": "parallel-docs.workspaceInitialized && parallel-docs.activeEditorIsResolvableCompanionMarkdown"
      },
      {
        "command": "parallel-docs.removeBlock",
        "title": "Remove side-track block/region",
        "category": "ParallelDocs",
        "enablement": "parallel-docs.workspaceInitialized && !editorReadonly"
      },
      {
        "command": "parallel-docs.cleanRegions",
        "title": "Clean and align parallel-docs regions",
        "category": "ParallelDocs",
        "enablement": "parallel-docs.workspaceInitialized"
      },
      {
        "command": "parallel-docs.repairFile",
        "title": "Repair parallel-docs region markers",
        "category": "ParallelDocs",
        "enablement": "parallel-docs.workspaceInitialized && !editorReadonly"
      }
    ],
    "keybindings": [
      {
        "command": "parallel-docs.openSideBySide",
        "key": "ctrl+alt+o",
        "mac": "cmd+alt+o",
        "when": "editorTextFocus && parallel-docs.workspaceInitialized && !parallel-docs.activeEditorUnderCompanionSourceTree"
      },
      {
        "command": "parallel-docs.startBlockFromSelection",
        "key": "ctrl+alt+k",
        "mac": "cmd+alt+k",
        "when": "editorTextFocus && parallel-docs.workspaceInitialized && !editorReadonly && !parallel-docs.activeEditorUnderCompanionSourceTree"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "parallel-docs.init",
          "group": "parallel-docs@0",
          "when": "editorTextFocus && !parallel-docs.workspaceInitialized"
        },
        {
          "command": "parallel-docs.openSideBySide",
          "group": "parallel-docs@1",
          "when": "editorTextFocus && parallel-docs.workspaceInitialized && !parallel-docs.activeEditorUnderCompanionSourceTree"
        },
        {
          "command": "parallel-docs.openParallelDocsAngle",
          "group": "parallel-docs@1b",
          "when": "editorTextFocus && parallel-docs.workspaceInitialized && !parallel-docs.activeEditorUnderCompanionSourceTree"
        },
        {
          "command": "parallel-docs.openRenderedPreview",
          "group": "parallel-docs@1d",
          "when": "editorTextFocus && parallel-docs.workspaceInitialized && !parallel-docs.activeEditorUnderCompanionSourceTree"
        },
        {
          "command": "parallel-docs.openRenderedPreviewChooseAngle",
          "group": "parallel-docs@1e",
          "when": "editorTextFocus && parallel-docs.workspaceInitialized && !parallel-docs.activeEditorUnderCompanionSourceTree"
        },
        {
          "command": "parallel-docs.addAngleDefinition",
          "group": "parallel-docs@1c",
          "when": "editorTextFocus && parallel-docs.workspaceInitialized"
        },
        {
          "command": "parallel-docs.startBlockFromSelection",
          "group": "parallel-docs@2",
          "when": "editorTextFocus && parallel-docs.workspaceInitialized && !editorReadonly && !parallel-docs.activeEditorUnderCompanionSourceTree"
        },
        {
          "command": "parallel-docs.openCorrespondingSource",
          "group": "parallel-docs@1f",
          "when": "editorTextFocus && parallel-docs.workspaceInitialized && parallel-docs.activeEditorIsResolvableCompanionMarkdown"
        },
        {
          "command": "parallel-docs.removeBlock",
          "group": "parallel-docs@2a",
          "when": "editorTextFocus && parallel-docs.workspaceInitialized && !editorReadonly"
        },
        {
          "command": "parallel-docs.cleanRegions",
          "group": "parallel-docs@2b",
          "when": "editorTextFocus && parallel-docs.workspaceInitialized"
        },
        {
          "command": "parallel-docs.repairFile",
          "group": "parallel-docs@2c",
          "when": "editorTextFocus && parallel-docs.workspaceInitialized && !editorReadonly"
        }
      ],
      "explorer/context": [
        {
          "command": "parallel-docs.init",
          "group": "parallel-docs@0",
          "when": "resourceScheme == file && !parallel-docs.workspaceInitialized"
        },
        {
          "command": "parallel-docs.openSideBySide",
          "group": "parallel-docs@1",
          "when": "resourceScheme == file && parallel-docs.workspaceInitialized"
        }
      ]
    },
    "snippets": [
      {
        "language": "markdown",
        "path": "./snippets/parallel-docs-markdown.code-snippets"
      }
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ./esbuild.extension.mjs",
    "build:extension": "tsc -p tsconfig.build.json && node ./esbuild.extension.mjs",
    "clean": "rm -rf dist",
    "test:vscode": "tsc -p tsconfig.tests.json && vscode-test"
  },
  "dependencies": {
    "@parallel-docs/core": "1.0.0",
    "@parallel-docs/render": "1.0.0"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.0.1",
    "@types/vscode": "^1.95.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "esbuild": "^0.28.1",
    "mocha": "^11.8.0"
  }
}
