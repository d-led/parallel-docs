{
  "name": "sidetrack-vscode",
  "displayName": "SideTrack",
  "description": "Out-of-file documentation side tracks, authored side-by-side with your code",
  "version": "1.0.0",
  "publisher": "d-led",
  "license": "MPL-2.0",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/d-led/sidetrack.git",
    "directory": "packages/vscode"
  },
  "homepage": "https://github.com/d-led/sidetrack#readme",
  "bugs": {
    "url": "https://github.com/d-led/sidetrack/issues"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:sidetrack.init",
    "onCommand:sidetrack.openSideBySide",
    "onCommand:sidetrack.openSideTrackAngle",
    "onCommand:sidetrack.addAngleDefinition",
    "onCommand:sidetrack.startBlockFromSelection",
    "onCommand:sidetrack.openSideTrackPreview",
    "onCommand:sidetrack.openRenderedPreview",
    "onCommand:sidetrack.openRenderedPreviewChooseAngle",
    "onCommand:sidetrack.validateWorkspace",
    "onCommand:sidetrack.openCorrespondingSource",
    "onCommand:sidetrack.removeBlock",
    "onCommand:sidetrack.cleanRegions",
    "onCommand:sidetrack.repairFile"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "SideTrack",
      "properties": {
        "sidetrack.scrollSync.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "When enabled, scrolling the source editor updates the paired sidetrack editor (and vice versa), using block anchors when available. Reload or reopen the pair after changing this setting."
        }
      }
    },
    "commands": [
      {
        "command": "sidetrack.init",
        "title": "Initialize workspace",
        "category": "SideTrack",
        "enablement": "!sidetrack.workspaceInitialized"
      },
      {
        "command": "sidetrack.openSideBySide",
        "title": "Open paired markdown beside editor",
        "category": "SideTrack",
        "enablement": "sidetrack.workspaceInitialized && !sidetrack.activeEditorUnderCompanionSourceTree"
      },
      {
        "command": "sidetrack.openSideTrackAngle",
        "title": "Open paired markdown (choose angle)",
        "category": "SideTrack",
        "enablement": "sidetrack.workspaceInitialized && !sidetrack.activeEditorUnderCompanionSourceTree"
      },
      {
        "command": "sidetrack.addAngleDefinition",
        "title": "Add angle to project…",
        "category": "SideTrack",
        "enablement": "sidetrack.workspaceInitialized"
      },
      {
        "command": "sidetrack.startBlockFromSelection",
        "title": "Add side-track block from selection",
        "category": "SideTrack",
        "enablement": "sidetrack.workspaceInitialized && !sidetrack.activeEditorUnderCompanionSourceTree && !editorReadonly"
      },
      {
        "command": "sidetrack.openSideTrackPreview",
        "title": "Open Markdown preview for paired file",
        "category": "SideTrack",
        "enablement": "sidetrack.workspaceInitialized && (!sidetrack.activeEditorUnderCompanionSourceTree || editorLangId == markdown)"
      },
      {
        "command": "sidetrack.openRenderedPreview",
        "title": "Open rendered SideTrack preview (default angle)",
        "category": "SideTrack",
        "enablement": "sidetrack.workspaceInitialized && !sidetrack.activeEditorUnderCompanionSourceTree"
      },
      {
        "command": "sidetrack.openRenderedPreviewChooseAngle",
        "title": "Open rendered SideTrack preview (choose angle)…",
        "category": "SideTrack",
        "enablement": "sidetrack.workspaceInitialized && !sidetrack.activeEditorUnderCompanionSourceTree"
      },
      {
        "command": "sidetrack.validateWorkspace",
        "title": "Validate workspace",
        "category": "SideTrack"
      },
      {
        "command": "sidetrack.openCorrespondingSource",
        "title": "Open corresponding source file",
        "category": "SideTrack",
        "enablement": "sidetrack.workspaceInitialized && sidetrack.activeEditorIsResolvableCompanionMarkdown"
      },
      {
        "command": "sidetrack.removeBlock",
        "title": "Remove side-track block/region",
        "category": "SideTrack",
        "enablement": "sidetrack.workspaceInitialized && !editorReadonly"
      },
      {
        "command": "sidetrack.cleanRegions",
        "title": "Clean and align sidetrack regions",
        "category": "SideTrack",
        "enablement": "sidetrack.workspaceInitialized"
      },
      {
        "command": "sidetrack.repairFile",
        "title": "Repair sidetrack region markers",
        "category": "SideTrack",
        "enablement": "sidetrack.workspaceInitialized && !editorReadonly"
      }
    ],
    "keybindings": [
      {
        "command": "sidetrack.openSideBySide",
        "key": "ctrl+alt+o",
        "mac": "cmd+alt+o",
        "when": "editorTextFocus && sidetrack.workspaceInitialized && !sidetrack.activeEditorUnderCompanionSourceTree"
      },
      {
        "command": "sidetrack.startBlockFromSelection",
        "key": "ctrl+alt+k",
        "mac": "cmd+alt+k",
        "when": "editorTextFocus && sidetrack.workspaceInitialized && !editorReadonly && !sidetrack.activeEditorUnderCompanionSourceTree"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "sidetrack.init",
          "group": "sidetrack@0",
          "when": "editorTextFocus && !sidetrack.workspaceInitialized"
        },
        {
          "command": "sidetrack.openSideBySide",
          "group": "sidetrack@1",
          "when": "editorTextFocus && sidetrack.workspaceInitialized && !sidetrack.activeEditorUnderCompanionSourceTree"
        },
        {
          "command": "sidetrack.openSideTrackAngle",
          "group": "sidetrack@1b",
          "when": "editorTextFocus && sidetrack.workspaceInitialized && !sidetrack.activeEditorUnderCompanionSourceTree"
        },
        {
          "command": "sidetrack.openRenderedPreview",
          "group": "sidetrack@1d",
          "when": "editorTextFocus && sidetrack.workspaceInitialized && !sidetrack.activeEditorUnderCompanionSourceTree"
        },
        {
          "command": "sidetrack.openRenderedPreviewChooseAngle",
          "group": "sidetrack@1e",
          "when": "editorTextFocus && sidetrack.workspaceInitialized && !sidetrack.activeEditorUnderCompanionSourceTree"
        },
        {
          "command": "sidetrack.addAngleDefinition",
          "group": "sidetrack@1c",
          "when": "editorTextFocus && sidetrack.workspaceInitialized"
        },
        {
          "command": "sidetrack.startBlockFromSelection",
          "group": "sidetrack@2",
          "when": "editorTextFocus && sidetrack.workspaceInitialized && !editorReadonly && !sidetrack.activeEditorUnderCompanionSourceTree"
        },
        {
          "command": "sidetrack.openCorrespondingSource",
          "group": "sidetrack@1f",
          "when": "editorTextFocus && sidetrack.workspaceInitialized && sidetrack.activeEditorIsResolvableCompanionMarkdown"
        },
        {
          "command": "sidetrack.removeBlock",
          "group": "sidetrack@2a",
          "when": "editorTextFocus && sidetrack.workspaceInitialized && !editorReadonly"
        },
        {
          "command": "sidetrack.cleanRegions",
          "group": "sidetrack@2b",
          "when": "editorTextFocus && sidetrack.workspaceInitialized"
        },
        {
          "command": "sidetrack.repairFile",
          "group": "sidetrack@2c",
          "when": "editorTextFocus && sidetrack.workspaceInitialized && !editorReadonly"
        }
      ],
      "explorer/context": [
        {
          "command": "sidetrack.init",
          "group": "sidetrack@0",
          "when": "resourceScheme == file && !sidetrack.workspaceInitialized"
        },
        {
          "command": "sidetrack.openSideBySide",
          "group": "sidetrack@1",
          "when": "resourceScheme == file && sidetrack.workspaceInitialized"
        }
      ]
    },
    "snippets": [
      {
        "language": "markdown",
        "path": "./snippets/sidetrack-markdown.code-snippets"
      }
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ./esbuild.extension.mjs",
    "build:extension": "tsc -p tsconfig.build.json && node ./esbuild.extension.mjs",
    "clean": "rm -rf dist",
    "test:vscode": "tsc -p tsconfig.tests.json && vscode-test"
  },
  "dependencies": {
    "@sidetrack/core": "1.0.0",
    "@sidetrack/render": "1.0.0"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.0.1",
    "@types/vscode": "^1.95.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "esbuild": "^0.28.1",
    "mocha": "^11.8.0"
  }
}
