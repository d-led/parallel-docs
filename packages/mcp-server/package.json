{
  "name": "@parallel-docs/mcp-server",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "MCP (Model Context Protocol) server for ParallelDocs — exposes CLI commands as AI coding assistant tools",
  "license": "MPL-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@parallel-docs/code-parallel-docs-static": "1.0.0",
    "@parallel-docs/core": "1.0.0",
    "@parallel-docs/render": "1.0.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "serve-handler": "^6.1.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "@types/serve-handler": "^6.1.4"
  }
}
